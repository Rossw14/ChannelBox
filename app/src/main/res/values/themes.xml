<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/black</item>
    </style>

    <style name="SettingsTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/panel_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/black</item>
    </style>

    <style name="TvButton" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/button_bg</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="TvButtonSmall" parent="TvButton">
        <item name="android:textSize">14sp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:minWidth">0dp</item>
    </style>
</resources>
